# MyAnimeList Developer API Credentials
# Register your app at: https://myanimelist.net/apiconfig
# Redirect URI should be: http://localhost:3000/api/auth/callback
MAL_CLIENT_ID=your_mal_client_id_here
MAL_CLIENT_SECRET=your_mal_client_secret_here

# App URL (used for OAuth redirect URI construction)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session Secret (random 32-character string for securing cookies)
SESSION_SECRET=replace_with_a_secure_random_32_char_secret

# AI Roasting API Key (Gemini or OpenAI)
GEMINI_API_KEY=your_gemini_api_key_here
